#!/usr/bin/env bash
# Auto-deploy: every commit on main goes straight to Cloudflare (juns.win).
# Skip once with: SKIP_DEPLOY=1 git commit ...
set -euo pipefail
[[ -n "${SKIP_DEPLOY:-}" ]] && exit 0
[[ "$(git rev-parse --abbrev-ref HEAD)" == main ]] || exit 0
root=$(git rev-parse --show-toplevel)
echo "post-commit: deploying $(git rev-parse --short HEAD) to Cloudflare..."
"$root/scripts/deploy-cf.sh" 2>&1 | tail -n 3 || echo "post-commit: deploy failed — rerun scripts/deploy-cf.sh"
